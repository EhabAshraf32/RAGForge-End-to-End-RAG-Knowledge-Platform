# Copy to streamlit_app/.env (or set as environment variables). No secrets here: users type their
# credentials, which are exchanged with the backend for short-lived tokens.

# FastAPI backend base URL (including /api/v1). Use https:// when deployed publicly.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Admin app only: course project the TA manages. Must equal the backend STUDENT_PROJECT_ID.
ADMIN_DEFAULT_PROJECT_ID=

# Should match the backend FILE_MAX_SIZE (MB); the backend enforces it anyway
MAX_UPLOAD_MB=10

COURSE_TITLE=Structured Programming using C

# Same value as the backend TRUSTED_FRONTEND_SECRET (hosted deployments). Stays on the Streamlit server;
# lets the backend rate-limit each student separately. Leave empty for local use.
FRONTEND_SHARED_SECRET=
