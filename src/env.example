APP_NAME="mini-RAG"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB

MONGODB_URL=""
MONGODB_DATABASE=""

# ========================= LLM Config =========================
# Backends: OPENAI | HUGGINGFACE | COHERE (optional, not used by default)
# Generation goes through OpenRouter using the OpenAI-compatible provider (OPENAI + OPENAI_API_URL).
GENERATION_BACKEND="OPENAI"
# Embeddings run locally with sentence-transformers (no API key, no per-request cost)
EMBEDDING_BACKEND="HUGGINGFACE"

# OpenRouter key (https://openrouter.ai/keys) - used by the OPENAI backend together with OPENAI_API_URL
OPENAI_API_KEY=""
OPENAI_API_URL="https://openrouter.ai/api/v1"
# only needed if a backend is set to "COHERE"
COHERE_API_KEY=

# OpenRouter model id (check https://openrouter.ai/models). ":free" models need no credits but are rate-limited.
GENERATION_MODEL_ID="nvidia/nemotron-3.5-super-vl:free"
EMBEDDING_MODEL_ID="BAAI/bge-m3"
# must match the embedding model output (bge-m3 = 1024). Changing it requires re-indexing (new project or push do_reset=1)
EMBEDDING_MODEL_SIZE=1024

# max characters of one text sent to the EMBEDDING model (keep >= process chunk_size, default 1000)
INPUT_DAFAULT_MAX_CHARACTERS=1024
# max characters of one message sent to the GENERATION model (system prompt / retrieved context + question / history turn)
GENERATION_DAFAULT_MAX_INPUT_CHARACTERS=20000
# answers with C code, expected output and explanations need room (reasoning models also spend tokens thinking)
GENERATION_DAFAULT_MAX_TOKENS=3000
GENERATION_DAFAULT_TEMPERATURE=0.1
# seconds before an OpenRouter request is abandoned
OPENAI_API_TIMEOUT=120

# Groq (free tier, OpenAI-compatible): GENERATION_BACKEND="GROQ" and/or in GENERATION_FALLBACKS
GROQ_API_KEY=
# Google Gemini (free AI Studio key): GEMINI in GENERATION_FALLBACKS
GEMINI_API_KEY=
# extra providers tried in order when the primary one fails or hits its limit (BACKEND:MODEL_ID, comma separated).
# Optional "#N" = at most N answers per UTC day for that provider (e.g. Cloudflare shares its quota with embeddings)
# e.g. "GROQ:qwen/qwen3.8-27b,GEMINI:gemini-3.5-flash,OPENAI:nvidia/nemotron-3.5-super-vl:free,CLOUDFLARE:@cf/meta/llama-3.3-70b-instruct-fp8-fast#20"
GENERATION_FALLBACKS=

# client-side conversation history accepted by /nlp/index/answer (stateless backend)
RAG_HISTORY_MAX_MESSAGES=6
RAG_HISTORY_MAX_CHARACTERS=3000

# ========================= Security =========================
# REQUIRED - the API refuses to start without it (>= 32 chars). Generate (from src/):
#   python -m helpers.security secret
JWT_SECRET_KEY=
JWT_ALGORITHM="HS256"

# TA / admin login. Store the HASH, never the plain password. Generate (prompts, nothing is echoed):
#   python -m helpers.security hash
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_EXPIRE_MINUTES=60

# Students log in with a course access code the TA shares (store its HASH, generated the same way) and can only
# ask questions about STUDENT_PROJECT_ID (the project the TA uploads the course materials to; letters/digits only)
STUDENT_ACCESS_CODE_HASH=
STUDENT_PROJECT_ID=
STUDENT_TOKEN_EXPIRE_MINUTES=480

# Rate limits (in-memory, single backend process; 0 disables a limit)
# login attempts per client IP per window (admin + student logins together)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# questions per student session
STUDENT_ANSWER_RATE_LIMIT_PER_MINUTE=5
STUDENT_ANSWER_RATE_LIMIT_PER_HOUR=60
# Hosted frontends call the API server-side, so all their users share one IP. They forward the end user's IP
# with this shared secret (set the same value as FRONTEND_SHARED_SECRET in the Streamlit apps). Rate limiting only.
TRUSTED_FRONTEND_SECRET=

# ========================= Hosted deployment (optional) =========================
# Embeddings on Cloudflare Workers AI instead of local: EMBEDDING_BACKEND="CLOUDFLARE",
# EMBEDDING_MODEL_ID="@cf/baai/bge-m3", EMBEDDING_MODEL_SIZE=1024 (same model as local BAAI/bge-m3)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# keep uploaded PDFs in MongoDB GridFS (servers with an ephemeral disk, e.g. Render free)
STORE_FILES_IN_DB=false

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
# Qdrant server / Qdrant Cloud: when QDRANT_URL is set it is used instead of the local VECTOR_DB_PATH
QDRANT_URL=
QDRANT_API_KEY=

# ========================= Template Configs =========================
# default prompt language; each question is answered with the Arabic or English templates automatically
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"
